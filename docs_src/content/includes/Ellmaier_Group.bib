@article{eserDistributedNonlinear2025,
  title = {Distributed Nonlinear Model Predictive Control for Building Energy Systems: {{An ALADIN}} Implementation Study},
  shorttitle = {Distributed Nonlinear Model Predictive Control for Building Energy Systems},
  author = {Eser, Steffen and Spoek, Ben and Sch\"utz, Augustinus and Stoffel, Phillip and M\"uller, Dirk},
  date = {2025-09-01},
  journaltitle = {Energy and AI},
