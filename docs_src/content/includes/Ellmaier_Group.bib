  title = {Alternative {{Direction Multiblock Method}} with {{Nesterov Acceleration}} and {{Its Applications}}},
  booktitle = {Computational {{Methods}} and {{Mathematical Modeling}} in {{Cyberphysics}} and {{Engineering Applications}} 1},
  author = {Hryhorenko, Vladislav and Lyashko, Nataliia and Lyashko, Sergiy and Klyushin, Dmytro},
  date = {2024},
  pages = {121--147},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781394284344.ch6},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394284344.ch6},
  urldate = {2025-05-23},
  abstract = {Proximal algorithms in machine learning are useful for solving the problem of optimizing a complex function. An useful feature of proximal methods is the ability to apply approaches that significantly increase computational efficiency. One of the most effective proximal methods is the alternating direction method of multipliers (ADMM) method. One way to interpret the ADMM method is to use a proximal gradient method for a dual problem. This chapter compares the performance of the modified Nesterov-accelerated multiblock ADMM with conventional multiblock and classical two-block ADMM methods. Multiblock ADMM is much more efficient than standard two-block ADMM, and applying Nesterov's acceleration at each iteration of multiblock ADMM significantly increases the rate of convergence of the method. ADMM is a very handy tool for solving a large number of optimization problems in statistics, machine learning and pattern recognition, and is very well suited for distributed computing.},
  isbn = {978-1-394-28434-4},
  langid = {english},
  keywords = {alternating direction method of multipliers,Bregman iteration,complex function,machine learning,Nesterov acceleration,pattern recognition,proximal methods},
}

@inproceedings{hryhorenkoMultiblockADMM2019,
