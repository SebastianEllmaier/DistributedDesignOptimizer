@book{prennerMassnahmenZur2013a,
  title = {Ma\ss nahmen Zur {{Optimierung}} Des {{CAS}}/{{CAD}}/{{CFD-Prozesses}} in Der Konzeptionellen {{Fahrzeug-Aerodynamikentwicklung}}},
  author = {Prenner, Martin and Hirz, Mario and Stadler, Severin and Mayr, Johannes},
  date = {2013-03-01},
  abstract = {To use the entire potential of aerodynamics, extensive investigations of styling proposals are necessary already in the early concept phase of an automotive development process. The approach in this paper counters the complicating boundary conditions of this phase, like insufficient quality of styling surfaces, unknown engineering data or missing components and too long cycle times. Therefore the workflow in the CAS (computer-aided styling) / CAD (computer-aided design) / CFD (computational fluid dynamics) -process was analysed. On the basis of this analysis an optimized process was developed, which includes various measures. First, suggestions which enable an efficient preparation of styling surfaces in a computer-based engineering software (3D-CAD) were developed. Second, a parametric-associative 3D-CAD vehicle model, including a parametric motor compartment allows the integration of prepared styling surfaces into full-vehicle models. Third, the exchange of geometries between the different CAE-environments was investigated. Fourth, a specific set of parameters and settings with the aim to achieve a considerable optimization of the calculation model was developed and integrated in a CFD-template file. An application of this template-file leads to a reduction of the computing time during the CFD-calculation. Furthermore, specific automated routines for an additional acceleration of the workflow within the CFD-environment were worked out. Besides the calculation of drag coefficients, the presented method enables the assessment and evaluation of the flow behaviour in the motor compartment and the cooling system as well as the consideration of trend statements regarding aerodynamic vehicle lift values. In this way, the present approach supports an efficient aerodynamic development, especially during the early phases.},
}

