@article{zitzlerPerformanceAssessment2003,
  title = {Performance Assessment of Multiobjective Optimizers: An Analysis and Review},
  shorttitle = {Performance Assessment of Multiobjective Optimizers},
  author = {Zitzler, E. and Thiele, L. and Laumanns, M. and Fonseca, C.M. and Da Fonseca, V.G.},
  date = {2003-04},
  journaltitle = {IEEE Transactions on Evolutionary Computation},
  shortjournal = {IEEE Trans. Evol. Computat.},
  volume = {7},
  number = {2},
  pages = {117--132},
  issn = {1089-778X},
  doi = {10.1109/TEVC.2003.810758},
  url = {http://ieeexplore.ieee.org/document/1197687/},
  urldate = {2025-11-13},
  abstract = {An important issue in multiobjective optimization is the quantitative comparison of the performance of different algorithms. In the case of multiobjective evolutionary algorithms, the outcome is usually an approximation of the Pareto-optimal set, which is denoted as an approximation set, and therefore the question arises of how to evaluate the quality of approximation sets. Most popular are methods that assign each approximation set a vector of real numbers that reflect different aspects of the quality. Sometimes, pairs of approximation sets are considered too. In this study, we provide a rigorous analysis of the limitations underlying this type of quality assessment. To this end, a mathematical framework is developed which allows to classify and discuss existing techniques.},
  langid = {english},
}
