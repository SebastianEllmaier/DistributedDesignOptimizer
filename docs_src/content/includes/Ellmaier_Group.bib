@online{huangInexactMoreau2025,
  title = {Inexact {{Moreau Envelope Lagrangian Method}} for {{Non-Convex Constrained Optimization}} under {{Local Error Bound Conditions}} on {{Constraint Functions}}},
  author = {Huang, Yankun and Lin, Qihang and Xu, Yangyang},
  date = {2025-02-27},
  eprint = {2502.19764},
  eprinttype = {arXiv},
  eprintclass = {cs, math},
  doi = {10.48550/arXiv.2502.19764},
  url = {http://arxiv.org/abs/2502.19764},
  urldate = {2025-06-16},
  abstract = {In this paper, we study the inexact Moreau envelope Lagrangian (iMELa) method for solving smooth non-convex optimization problems over a simple polytope with additional convex inequality constraints. By incorporating a proximal term into the traditional Lagrangian function, the iMELa method approximately solves a convex optimization subproblem over the polyhedral set at each main iteration. Under the assumption of a local error bound condition for subsets of the feasible set defined by subsets of the constraints, we establish that the iMELa method can find an \$\textbackslash epsilon\$-Karush-Kuhn-Tucker point with \$\textbackslash tilde O(\textbackslash epsilon\textasciicircum\{-2\})\$ gradient oracle complexity.},
  pubstate = {prepublished},
  keywords = {Computer Science - Machine Learning,Mathematics - Optimization and Control},
}

