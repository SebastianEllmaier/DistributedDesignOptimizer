@online{vankampenTwodimensionalSpatial2023a,
  title = {A {{Two-dimensional Spatial Optimization Framework}} for {{Vehicle Powertrain Systems}}},
  author = {family=Kampen, given=Jorn, prefix=van, useprefix=true and Salazar, Mauro and Hofman, Theo},
  date = {2023-06-08},
  eprint = {2306.05140},
  eprinttype = {arXiv},
  eprintclass = {cs, eess},
  doi = {10.48550/arXiv.2306.05140},
  url = {http://arxiv.org/abs/2306.05140},
  urldate = {2024-02-28},
  abstract = {This paper presents a modeling framework to optimize the two-dimensional placement of powertrain elements inside the vehicle, explicitly accounting for the rotation, relative placement and alignment. Specifically, we first capture the multi-level nature of the system mathematically, and construct a model that captures different powertrain component orientations. Second, we include the relative element placement as variables in the model and derive alignment constraints for both child components and parent subsystems to automatically connect mechanical ports. Finally, we showcase our framework on a four-wheel driven electric vehicle. Our results demonstrate that our framework is capable of efficiently generating system design solutions in a fully automated manner, only using basic component properties.},
  issue = {arXiv:2306.05140},
  pubstate = {prepublished},
  keywords = {Electrical Engineering and Systems Science - Systems and Control},
}

@incollection{vankanMultidisciplinaryModelling2022a,
  title = {Multidisciplinary {{Modelling}}, {{Analysis}} and {{Optimization}} for {{Aircraft}} and {{System Level Design}} and {{Validation}}},
  booktitle = {Advances in {{Computational Methods}} and {{Technologies}} in {{Aeronautics}} and {{Industry}}},
  author = {Vankan, W. J. and Lammen, W. F. and Baalbergen, E. H.},
  editor = {Knoerzer, Dietrich and Periaux, Jacques and Tuovinen, Tero},
  date = {2022},
  pages = {145--157},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-031-12019-0_11},
  url = {https://doi.org/10.1007/978-3-031-12019-0_11},
  urldate = {2024-06-16},
  abstract = {Against the background of the big environmental and societal challenges as formulated for example in Flightpath 2050, current developments in aircraft design are aiming at further emission reduction through integrated, unconventional propulsion, systems and airframe innovations. This requires the further integration of methods for multidisciplinary modelling, analysis and optimization for aircraft design, but also for propulsion and system level designs. Moreover, experimental validation of the methods and physical testing of critical unconventional propulsion and system designs are prerequisites for industrially relevant development processes. This paper presents some key technologies for computationally efficient collaborative MDO (multidisciplinary design and optimization) frameworks for multidisciplinary design and validation of advanced aeronautic products like aircraft and propulsion systems.},
  isbn = {978-3-031-12019-0},
  langid = {english},
  keywords = {BRICS,Collaborative engineering,MDO,MULTIFIT,SMR},
}

@article{vanluenenBayesianFramework2024,
  title = {A {{Bayesian Framework}} for {{Electric Machine Geometry Optimisation}} in {{Powertrains}}},
  author = {family=Luenen, given=J W, prefix=van, useprefix=true and Lomonova, E and Caarls, Dr E Ilhan and Bayazit, G H},
  date = {2024},
  abstract = {This paper presents a framework for the optimisation of electric vehicle powertrains utilising physics-based models for the estimation of electric machine performance. Specifically, the framework employs high-fidelity finite element modelling to parameterise the electric motor. This allows for detailed study of the geometry. The framework utilises Bayesian optimisation for a continuously improving estimation of the cost function, supplying information before the optimisation has finished. The effect of the rotor geometry parameters is studied by comparing two optimised powertrains, of which only one includes rotor parameters in its decision variables. By including the magnet size as a decision variable the optimiser is able to reduce the energy consumption by 0.3\%, but with a significantly longer machine and a smaller diameter, emphasising that including internal geometry parameters on high-level powertrain optimisation is impactful. The optimiser is then applied to the optimisation of the machine rotor alone, to study the impact on the powertrain performance. This is found give a 0.5\% reduction in vehicle energy consumption, without the inclusion of external parameters such as the gearing ratio.},
  langid = {english},
}

@inproceedings{vantoorenSystemsEngineering2008a,
  title = {Systems {{Engineering}} and {{Multi-disciplinary Design Optimization}}},
  booktitle = {Collaborative {{Product}} and {{Service Life Cycle Management}} for a {{Sustainable World}}},
  author = {family=Tooren, given=Michel, prefix=van, useprefix=true and La Rocca, Gianfranco},
  editor = {Curran, Richard and Chou, Shuo-Yan and Trappey, Amy},
  date = {2008},
  pages = {401--415},
  publisher = {Springer},
  location = {London},
  doi = {10.1007/978-1-84800-972-1_38},
  abstract = {The worlds of Systems Engineering and Multi-disciplinary Design Optimization are distinct disciplines which represent the qualitative and quantitative side of product development methodology. Merging these two worlds would improve the applicability of both. This will,however, require a substantial range of additional concepts, methods and tools on both sides. The Design and Engineering Engine is such a concept. It sets a framework in which part of the abstractions from Systems Engineering can be implemented using the Multi-disciplinary Design Optimization approach as a structured design domain search. The Design and Engineering Engine adds the concepts of High-Level Primitives and Capability Modules to structure a-priori product family characterization and re-usability of engineering processes. The potential of the concepts has been shown successful in several pilot projects.},
  isbn = {978-1-84800-972-1},
  langid = {english},
}

