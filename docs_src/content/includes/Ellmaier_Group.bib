@incollection{bilMultidisciplinaryDesign2015a,
  title = {Multidisciplinary {{Design Optimization}}: {{Designed}} by {{Computer}}},
  shorttitle = {Multidisciplinary {{Design Optimization}}},
  booktitle = {Concurrent {{Engineering}} in the 21st {{Century}}: {{Foundations}}, {{Developments}} and {{Challenges}}},
