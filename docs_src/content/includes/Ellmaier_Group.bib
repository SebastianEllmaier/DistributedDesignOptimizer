  langid = {english},
}

@article{rukshaDecompositionMethods2022,
  title = {Decomposition {{Methods}} for the {{Network Optimization Problem}} of {{Simultaneous Routing}} and {{Bandwidth Allocation Based}} on {{Lagrangian Relaxation}}},
  author = {Ruksha, Ihnat and Karbowski, Andrzej},
  date = {2022-01},
  journaltitle = {Energies},
  volume = {15},
  number = {20},
  pages = {7634},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {1996-1073},
  doi = {10.3390/en15207634},
  url = {https://www.mdpi.com/1996-1073/15/20/7634},
  urldate = {2025-03-03},
  abstract = {The main purpose of the work was examining various methods of decomposition of a network optimization problem of simultaneous routing and bandwidth allocation based on Lagrangian relaxation. The problem studied is an NP-hard mixed-integer nonlinear optimization problem. Multiple formulations of the optimization problem are proposed for the problem decomposition. The decomposition methods used several problem formulations and different choices of the dualized constraints. A simple gradient coordination algorithm, cutting-plane coordination algorithm, and their more sophisticated variants were used to solve dual problems. The performance of the proposed decomposition methods was compared to the commercial solver CPLEX and a heuristic algorithm.},
  issue = {20},
  langid = {english},
  keywords = {bandwidth allocation,branch and bound,CPLEX,cutting-plane method,dual problem,green networking,Lagrangian relaxation,MINLP,MIQP,multi-criteria,network optimization,NP-hard problems,optimization,Pyomo,routing,simple gradient algorithm},
}

@book{rybergMetamodelBasedMultidisciplinary2012a,
  title = {Metamodel-{{Based Multidisciplinary Design Optimization}} for {{Automotive Applications}}},
  author = {Ryberg, Ann-Britt and Domeij B\"ackryd, Rebecka and Nilsson, Larsgunnar},
