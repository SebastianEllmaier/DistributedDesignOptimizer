  booktitle = {Recent {{Developments}} in {{Data Science}} and {{Intelligent Analysis}} of {{Information}}},
  author = {Hryhorenko, Vladyslav and Klyushin, Dmitry},
  editor = {Chertov, Oleg and Mylovanov, Tymofiy and Kondratenko, Yuriy and Kacprzyk, Janusz and Kreinovich, Vladik and Stefanuk, Vadim},
  date = {2019},
  pages = {358--364},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-319-97885-7_35},
  abstract = {ADMM (alternating direction methods of multipliers) is used for solving many optimization problems. This method is particularly important in machine learning, statistics, image, and signal processing. The goal of this research is to develop an improved version of ADMM with better performance. For this purpose, we use combination of two approaches, namely, decomposition of original optimization problem into N subproblems and calculating Nesterov acceleration step on each iteration. We implement proposed algorithm using Python programming language and apply it for solving basis pursuit problem with randomly generated distributed data. We compare efficiency of ADMM with Nesterov acceleration and existing multiblock ADMM and classic two-block ADMM.},
  isbn = {978-3-319-97885-7},
  langid = {english},
  keywords = {Alternating direction method of multipliers,Fast ADMM,Multiblock ADMM,Nesterov acceleration},
}

@online{huangAlternatingDirection2021,
  title = {Alternating {{Direction Method}} of {{Multipliers}} for {{Quantization}}},
  author = {Huang, Tianjian and Singhania, Prajwal and Sanjabi, Maziar and Mitra, Pabitra and Razaviyayn, Meisam},
  date = {2021-03-01},
  eprint = {2009.03482},
  eprinttype = {arXiv},
  eprintclass = {cs, math},
  doi = {10.48550/arXiv.2009.03482},
  url = {http://arxiv.org/abs/2009.03482},
  urldate = {2025-01-17},
  abstract = {Quantization of the parameters of machine learning models, such as deep neural networks, requires solving constrained optimization problems, where the constraint set is formed by the Cartesian product of many simple discrete sets. For such optimization problems, we study the performance of the Alternating Direction Method of Multipliers for Quantization (\$\textbackslash texttt\{ADMM-Q\}\$) algorithm, which is a variant of the widely-used ADMM method applied to our discrete optimization problem. We establish the convergence of the iterates of \$\textbackslash texttt\{ADMM-Q\}\$ to certain \$\textbackslash textit\{stationary points\}\$. To the best of our knowledge, this is the first analysis of an ADMM-type method for problems with discrete variables/constraints. Based on our theoretical insights, we develop a few variants of \$\textbackslash texttt\{ADMM-Q\}\$ that can handle inexact update rules, and have improved performance via the use of "soft projection" and "injecting randomness to the algorithm". We empirically evaluate the efficacy of our proposed approaches.},
  pubstate = {prepublished},
  keywords = {Computer Science - Machine Learning,Mathematics - Optimization and Control},
}

