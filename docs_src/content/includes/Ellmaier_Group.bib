@article{gandikotaMultilevelDesign2016a,
  title = {Multilevel Design Optimisation of a Vehicle-Dummy Model under Crash, Vibration and Injury Criteria},
  author = {Gandikota, Imtiaz and Rais-Rohani, Masoud and Kiani, Morteza and DorMohammadi, Saber},
  date = {2016-01},
  journaltitle = {International Journal of Vehicle Design},
  volume = {70},
  number = {1},
  pages = {45--68},
  publisher = {Inderscience Publishers},
  issn = {0143-3369},
  doi = {10.1504/IJVD.2016.073703},
  url = {https://www.inderscienceonline.com/doi/10.1504/IJVD.2016.073703},
  urldate = {2024-03-28},
  abstract = {A decomposed formulation and solution approach is presented for multidisciplinary vehicle design optimisation under crashworthiness, occupant safety, mass, and vibration design criteria. The vehicle model, equipped with a dummy and occupant restraint system, is used in nonlinear transient dynamic finite element simulations of both full frontal impact (FFI) and side impact (SI) for calculation of multiple injury criteria. A body-in-white vehicle model based on the corresponding crash finite element model is used for vibration analysis. The hierarchically decomposed multilevel optimisation problem consists of an injury criteria minimisation problem at the system level and separate mass minimisation problems subject to FFI and SI criteria at the subsystem level. Key aspects of the multilevel optimisation methodology are presented with the results showing a mass reduction of 8.7 kg in the vehicle model along an 8\% improvement in the injury index with no loss of vehicle rigidity relative to the baseline model.},
  issue = {1},
  keywords = {airbags,body-in-white,crash analysis,crash simulation,crashworthiness,design optimisation,dynamic modelling,FEM,FFI,finite element method,full frontal impact,multilevel optimisation,multiple injury criteria,nonlinear modelling,occupant safety,restraint systems,seatbelts,side impact,transient modelling,vehicle design,vehicle modelling,vehicle rigidity,vehicle vibration,vehicle-dummy models},
}

@article{gandikotaMultilevelVehicle2015a,
  title = {Multilevel Vehicle--Dummy Design Optimization for Mass and Injury Criteria Minimization},
  author = {Gandikota, Imtiaz and Rais-Rohani, Masoud and DorMohammadi, Saber and Kiani, Morteza},
  date = {2015-02-01},
  journaltitle = {Proceedings of the Institution of Mechanical Engineers, Part D: Journal of Automobile Engineering},
  volume = {229},
  number = {3},
  pages = {283--295},
  publisher = {IMECHE},
  issn = {0954-4070},
  doi = {10.1177/0954407014542626},
  url = {https://doi.org/10.1177/0954407014542626},
  urldate = {2024-03-28},
  abstract = {A vehicle?dummy multidisciplinary design optimization problem is treated as a multilevel system composed of structural and occupant restraint system design elements. The vehicle-based responses and the dummy-based responses are obtained from nonlinear transient dynamic finite element simulations of full frontal impacts and side impacts. The wall thicknesses of a set of energy-absorbing components together with the occupant restraint system control parameters associated with the seat belt and the airbag are treated as design variables and used to optimize the multilevel system to minimize both the structural mass and the selected injury criteria. Each element optimization problem is modeled using the augmented Lagrangian with exponential penalty function formulation. A single-loop coordination strategy is used to solve the multilevel optimization problem. To maximize the computational efficiency, surrogate models are used to approximate the vehicle-based responses and the dummy-based responses. The results of the vehicle?dummy design problem are used to examine the computational efficiency and the accuracy of the decomposed multilevel optimization methodology.},
  issue = {3},
  langid = {english},
}

