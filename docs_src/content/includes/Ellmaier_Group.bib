@online{liuNearoptimalMethod2025,
  title = {A {{Near-optimal Method}} for {{Linearly Constrained Composite Non-convex Non-smooth Problems}}},
  author = {Liu, Wei and Lin, Qihang and Xu, Yangyang},
  date = {2025-03-29},
  eprint = {2503.22927},
  eprinttype = {arXiv},
  doi = {10.48550/arXiv.2503.22927},
  url = {http://arxiv.org/abs/2503.22927},
  urldate = {2025-05-12},
  abstract = {We study first-order methods (FOMs) for solving \textbackslash emph\{composite nonconvex nonsmooth\} optimization with linear constraints. Recently, the lower complexity bounds of FOMs on finding an (\$\textbackslash varepsilon,\textbackslash varepsilon\$)-KKT point of the considered problem is established in \textbackslash cite\{liu2025lowercomplexityboundsfirstorder\}. However, optimization algorithms that achieve this lower bound had not been developed. In this paper, we propose an inexact proximal gradient method, where subproblems are solved using a recovering primal-dual procedure. Without making the bounded domain assumption, we establish that the oracle complexity of the proposed method, for finding an (\$\textbackslash varepsilon,\textbackslash varepsilon\$)-KKT point of the considered problem, matches the lower bounds up to a logarithmic factor. Consequently, in terms of the complexity, our algorithm outperforms all existing methods. We demonstrate the advantages of our proposed algorithm over the (linearized) alternating direction method of multipliers and the (proximal) augmented Lagrangian method in the numerical experiments.},
  pubstate = {prepublished},
  keywords = {Mathematics - Optimization and Control},
}

