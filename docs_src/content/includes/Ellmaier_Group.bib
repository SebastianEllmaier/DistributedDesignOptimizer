  publisher = {Springer Nature},
  location = {Singapore},
  doi = {10.1007/978-981-19-8594-2_3},
  url = {https://doi.org/10.1007/978-981-19-8594-2_3},
  urldate = {2024-11-26},
  abstract = {In this chapter, we investigate the fundamental economic operation problems in smart grid from model-based perspective, including EDP, DR, UCP, and OPF. Specifically, the optimization problems can be modeled as the deterministic models and we propose some distributed optimization algorithms by combining the multi-agent consensus theory and optimization techniques to achieve the distributed coordination of various generation units and loads in EDP, DR, UCP, and OPF problems. Specifically, for EDP and DR, different from the existing heuristic algorithms, our proposed distributed algorithm can guarantee the instantaneous power balance, which eliminates the need of extra algorithms to track the power mismatch between the supply and demand sides, thus improving the convergence speed. For UCP, we propose a closed-loop hierarchical operation algorithm which can produce the optimal schedule in a closed-loop style and conducts only scheduling phase for different initial conditions and external disturbances. For OPF, an ADMM-based cooperative approach was proposed, in which average negotiation was applied to set the target value for the boundary variables, thus neither a coordinator nor the global communication was required in the proposed approach.},
  isbn = {978-981-19859-4-2},
  langid = {english}
}

