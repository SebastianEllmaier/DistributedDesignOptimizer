@article{nicolettiTopologyAnalysis2021a,
  title = {Topology Analysis of Electric Vehicles, with a~Focus on the Traction Battery},
  author = {Nicoletti, Lorenzo and Ostermann, Franziska and Heinrich, Maximilian and Stauber, Alois and Lin, Xue and Lienkamp, Markus},
