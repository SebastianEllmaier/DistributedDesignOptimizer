@incollection{qinModelBasedDistributed2023,
  title = {Model-{{Based Distributed Optimization}}},
  booktitle = {Distributed {{Economic Operation}} in {{Smart Grid}}: {{Model-Based}} and {{Model-Free Perspectives}}},
  author = {Qin, Jiahu and Wan, Yanni and Li, Fangyuan and Kang, Yu and Fu, Weiming},
  editor = {Qin, Jiahu and Wan, Yanni and Li, Fangyuan and Kang, Yu and Fu, Weiming},
  date = {2023},
