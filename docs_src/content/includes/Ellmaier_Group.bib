@article{ramuSurveyMachine2022a,
  title = {A Survey of Machine Learning Techniques in Structural and Multidisciplinary Optimization},
  author = {Ramu, Palaniappan and Thananjayan, Pugazhenthi and Acar, Erdem and Bayrak, Gamze and Park, Jeong Woo and Lee, Ikjin},
  date = {2022-09-10},
