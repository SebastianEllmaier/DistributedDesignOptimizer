@article{liuAccelerationPrimal2021,
  title = {Acceleration of {{Primal}}--{{Dual Methods}} by {{Preconditioning}} and {{Simple Subproblem Procedures}}},
  author = {Liu, Yanli and Xu, Yunbei and Yin, Wotao},
  date = {2021-01-07},
  journaltitle = {Journal of Scientific Computing},
  shortjournal = {J Sci Comput},
  volume = {86},
  number = {2},
  pages = {21},
  issn = {1573-7691},
  doi = {10.1007/s10915-020-01371-1},
  url = {https://doi.org/10.1007/s10915-020-01371-1},
  urldate = {2025-05-27},
  abstract = {Primal--dual hybrid gradient (PDHG) and alternating direction method of multipliers (ADMM) are popular first-order optimization methods. They are easy to implement and have diverse applications. As first-order methods, however, they are sensitive to problem conditions and can struggle to reach the desired accuracy. To improve their performance, researchers have proposed techniques such as diagonal preconditioning and inexact subproblems. This paper realizes additional speedup about one order of magnitude. Specifically, we choose general (non-diagonal) preconditioners that are much more effective at reducing the total numbers of PDHG/ADMM iterations than diagonal ones. Although the subproblems may lose their closed-form solutions, we show that it suffices to solve each subproblem approximately with a few proximal-gradient iterations or a few epochs of proximal block-coordinate descent, which are simple and have closed-form steps. Global convergence of this approach is proved when the inner iterations are fixed. Our method opens the choices of preconditioners and maintains both low per-iteration cost and global convergence. Consequently, on several typical applications of primal--dual first-order methods, we obtain 4--95\$\$\textbackslash times \$\$speedup over the existing state-of-the-art.},
  langid = {english},
  keywords = {49M29,65K10,65Y20,90C25,Acceleration,Alternating direction method of multipliers,Calculus of Variations and Optimization,Computational Mathematics and Numerical Analysis,Discrete Optimization,Linear Algebra,Optimization,Partial Differential Equations,Preconditioning,Primal-dual hybrid gradient},
}

