@article{dengParallelMultiBlock2017,
  title = {Parallel {{Multi-Block ADMM}} with o(1~/~k) {{Convergence}}},
  author = {Deng, Wei and Lai, Ming-Jun and Peng, Zhimin and Yin, Wotao},
  date = {2017-05-01},
  journaltitle = {Journal of Scientific Computing},
  shortjournal = {J Sci Comput},
  volume = {71},
  number = {2},
  pages = {712--736},
  issn = {1573-7691},
  doi = {10.1007/s10915-016-0318-2},
  url = {https://doi.org/10.1007/s10915-016-0318-2},
  urldate = {2025-01-15},
  abstract = {This paper introduces a parallel and distributed algorithm for solving the following minimization problem with linear constraints: \$\$\textbackslash begin\{aligned\} \textbackslash text \{minimize\} \textasciitilde\textasciitilde\&f\_1(\textbackslash mathbf\{x\}\_1) + \textbackslash cdots + f\_N(\textbackslash mathbf\{x\}\_N)\textbackslash\textbackslash{} \textbackslash text \{subject to\}\textasciitilde\textasciitilde\&A\_1 \textbackslash mathbf\{x\}\_1 \textasciitilde + \textbackslash cdots + A\_N\textbackslash mathbf\{x\}\_N =c,\textbackslash\textbackslash\&\textbackslash mathbf\{x\}\_1\textbackslash in \{\textbackslash mathcal \{X\}\}\_1,\textasciitilde\textbackslash ldots , \textasciitilde\textbackslash mathbf\{x\}\_N\textbackslash in \{\textbackslash mathcal \{X\}\}\_N, \textbackslash end\{aligned\}\$\$minimizef1(x1)+{$\cdots$}+fN(xN)subject toA1x1+{$\cdots$}+ANxN=c,x1{$\in$}X1,\dots,xN{$\in$}XN,where \$\$N \textbackslash ge 2\$\$, \$\$f\_i\$\$are convex functions, \$\$A\_i\$\$are matrices, and \$\$\{\textbackslash mathcal \{X\}\}\_i\$\$are feasible sets for variable \$\$\textbackslash mathbf\{x\}\_i\$\$. Our algorithm extends the alternating direction method of multipliers (ADMM) and decomposes the original problem into N smaller subproblems and solves them in parallel at each iteration. This paper shows that the classic ADMM can be extended to the N-block Jacobi fashion and preserve convergence in the following two cases: (i) matrices \$\$A\_i\$\$are mutually near-orthogonal and have full column-rank, or (ii) proximal terms are added to the N subproblems (but without any assumption on matrices \$\$A\_i\$\$). In the latter case, certain proximal terms can let the subproblem be solved in more flexible and efficient ways. We show that \$\$\textbackslash Vert \{\textbackslash mathbf \{x\}\}\textasciicircum\{k+1\} - \{\textbackslash mathbf \{x\}\}\textasciicircum k\textbackslash Vert \_M\textasciicircum 2\$\$converges at a rate of o(1~/~k) where M is a symmetric positive semi-definte matrix. Since the parameters used in the convergence analysis are conservative, we introduce a strategy for automatically tuning the parameters to substantially accelerate our algorithm in practice. We implemented our algorithm (for the case ii above) on Amazon EC2 and tested it on basis pursuit problems with {$>$}300 GB of distributed data. This is the first time that successfully solving a compressive sensing problem of such a large scale is reported.},
  langid = {english},
  keywords = {ADMM,Alternating direction method of multipliers,Convergence rate,Parallel and distributed computing},
}

@article{denovellisDesignComparison2014a,
  title = {Design and Comparison of the Handling Performance of Different Electric Vehicle Layouts},
  author = {De Novellis, Leonardo and Sorniotti, Aldo and Gruber, Patrick},
  date = {2014-02-01},
  journaltitle = {Proceedings of the Institution of Mechanical Engineers, Part D: Journal of Automobile Engineering},
  volume = {228},
  number = {2},
  pages = {218--232},
  publisher = {IMECHE},
  issn = {0954-4070},
  doi = {10.1177/0954407013506569},
  url = {https://doi.org/10.1177/0954407013506569},
  urldate = {2024-06-27},
  abstract = {In contrast with conventional vehicles driven by an internal-combustion engine, the number of motors in fully electric cars is not fixed. A variety of architectural solutions, including from one to four individually controlled electric drive units, is possible and opens up new avenues in the design of vehicle characteristics. In particular, individual control of multiple electric powertrains promises to enhance the handling performance in steady-state and dynamic conditions. For the analysis and selection of the best electric powertrain layout based on the expected vehicle characteristics and performance, new analytical tools and metrics are required. This article presents and demonstrates a novel offline procedure for the design of the feedforward control action of the vehicle dynamics controller of a fully electric vehicle and three performance indicators for the objective comparison of the handling potential of alternative electric powertrain layouts. The results demonstrate that the proposed offline routine allows the desired understeer characteristics to be achieved with any of the investigated vehicle configurations, in traction and braking conditions. With respect to linear handling characteristics, the simulations indicate that the influence of torque-vectoring is independent of the location of the controlled axles (front or rear) and is considerably affected by the number of controlled axles.},
  issue = {2},
  langid = {english},
}

