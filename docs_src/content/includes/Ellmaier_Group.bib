@article{kruegerFunktionaleSynthese2024,
  title = {Funktionale Synthese und Optimierung elektrischer und hybrider Fahrzeugantriebe},
  author = {Kr\"uger, Bastian},
  date = {2024-02-02},
  url = {https://hss-opus.ub.ruhr-uni-bochum.de/opus4/frontdoor/index/index/docId/10869},
  urldate = {2024-06-18},
  abstract = {In dieser Arbeit wird eine Methode vorgestellt, mit der elektrische und hybride Antriebe gesamtheitlich hinsichtlich mehrerer Zielgr\"o\ss en optimiert werden k\"onnen. Das Ziel besteht darin, optimale Antriebe zu identifizieren, in welchem die Eigenschaften der Antriebsmaschinen und der Batterie passgenau auf die Funktionalit\"at des Getriebes abgestimmt sind. Der Kern der Arbeit stellt die Entwicklung von zwei Methoden zur Synthese ein- bzw. mehrmotoriger Antriebskonzepte entwickelt. Einmotorige Antriebe werden mithilfe funktionaler Bl\"ocke modelliert, die beliebig verkn\"upft werden k\"onnen. Die Synthese mehrmotoriger Antriebe basiert auf der sogenannten Funktionstopologie, die eine funktionale Synthese mehrmotoriger Antriebe erm\"oglicht. Zudem wird eine Optimierungsumgebung vorgestellt, in der die synthetisierten Antriebe hinsichtlich mehrerer Zielgr\"o\ss en optimiert werden k\"onnen. Anhand von drei Anwendungsbeispielen wird abschlie\ss end die Eignung der entwickelten Methode nachgewiesen.},
  langid = {ngerman},
}

