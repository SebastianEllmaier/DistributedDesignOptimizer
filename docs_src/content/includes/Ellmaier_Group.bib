  keywords = {65K05,90C26,90C30,Convergence rate,Extrapolation,Kurdyka-Lojasiewicz property,Nonconvex and nonsmooth optimization},
}

@inproceedings{liuCausalityAnalysis2021,
  title = {Causality {{Analysis}} of {{Industrial Process Based}} on {{Improved Convergent Cross Mapping}}},
  booktitle = {2021 {{China Automation Congress}} ({{CAC}})},
  author = {Liu, Chenxi and Deng, Yanni and Liu, Peibang and Su, Yixin and Huang, Weijie and Fan, Haiyang},
