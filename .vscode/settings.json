{
    "git.path": "C:\\Program Files\\PortableGit\\bin\\git.exe",
    "terminal.integrated.env.windows": {
        "PATH": "C:\\Program Files\\PortableGit\\bin\\;${env:PATH}"
    },    
    "git.openRepositoryInParentFolders": "always",
    "github.copilot.editor.enableAutoCompletions": true,
    "jupyter.enableExtendedPythonKernelCompletions": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.terminal.activateEnvironment": true,
    "python-envs.terminal.autoActivationType": "shellStartup",
    "python.useEnvironmentsExtension": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "editor.formatOnSave": false,
    },
    "editor.tabSize": 4,
    "editor.minimap.enabled": false,
    "flake8.args": [
        "--max-line-length=200",
        "--ignore=W291,W293"
    ],
    "python.linting.enabled": true,
    "python.linting.mypyEnabled": true,
    "mypy-type-checker.reportingScope": "workspace", // either "file"  (default) or "workspace" or >custom
    "mypy-type-checker.args": [
        "--disable-error-code=assignment",
        "--disable-error-code=index",
        "--disable-error-code=override",
        "--disable-error-code=arg-type",
        "--disable-error-code=operator",
        "--disable-error-code=return-value"
    ],
    "python.linting.pylintEnabled": true,
    "python.linting.pylintUseMinimalCheckers": false,
    "python.linting.mypyArgs": [
        "--strict"
    ],
    "pylint.args": [
        "--disable=C0103",
        "--disable=C0200",
        "--disable=W0105",
        "--disable=C0413",
        "--disable=C0303",
        "--disable=W0107",        
        "--disable=E1102",
        "--disable=E0239",
        "--max-line-length=200"
    ],
    "pylint.lintOnChange": true,    
    "debugpy.debugJustMyCode": false,
    "jupyter.debugJustMyCode": false,
    "debug.inlineValues": "on",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "diffEditor.useInlineViewWhenSpaceIsLimited": false,
    "github.copilot.nextEditSuggestions.fixes": false,
    "github.copilot.renameSuggestions.triggerAutomatically": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": false
    },
    "python.REPL.enableREPLSmartSend": false
    //"terminal.integrated.defaultProfile.windows": "Command Prompt",
}
