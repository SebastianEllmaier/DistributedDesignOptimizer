        <mxCell id="184zaT7-AdCGXbFeTAcl-2" parent="184zaT7-AdCGXbFeTAcl-1" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;spacingLeft=20;" value="&lt;p style=&quot;line-height: 180%;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(^{0}v_{f}(^{0}r) = W_t\)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 180%;&quot;&gt;\(^{0}v_{g}(^{0}r) = [ ^0v_{g_0}(^0r)] = [- \frac{R}{2000} + 1 ]\leq 0\)&lt;/p&gt;&lt;p style=&quot;line-height: 180%;&quot;&gt;\(^{0}v_{h}(^{0}r) = \emptyset = 0\)&lt;/p&gt;&lt;p style=&quot;line-height: 180%;&quot;&gt;\(^{0}r:= \begin{bmatrix} R (^{1}_{0}h,\:^{2}_{0}h,\:^{3}_{0}h&lt;br&gt;) \\ W_t(^1_0h, \:^3_0h)\end{bmatrix}\)&lt;/p&gt;&lt;p style=&quot;line-height: 180%;&quot;&gt;\(^{0}x := \emptyset\)&lt;br&gt;&lt;/p&gt;" vertex="1">
