        </mxCell>
        <mxCell id="184zaT7-AdCGXbFeTAcl-3" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=light-dark(#f6f6f6, #272727);labelBackgroundColor=none;" value="&lt;font face=&quot;Times New Roman&quot;&gt;Subsystem 1 (Propulsion)&lt;/font&gt;" vertex="1">
