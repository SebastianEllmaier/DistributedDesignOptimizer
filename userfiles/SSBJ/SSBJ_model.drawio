        <mxCell id="184zaT7-AdCGXbFeTAcl-4" parent="184zaT7-AdCGXbFeTAcl-3" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;spacingLeft=20;labelBackgroundColor=none;" value="&lt;p style=&quot;line-height: 180%;&quot;&gt;&lt;span style=&quot;float: none; color: rgb(0, 0, 0); display: inline !important;&quot;&gt;\(^{1}v_{f}(^{1}r) = 0\)&lt;/span&gt;&lt;br style=&quot;border-color: rgb(218, 218, 218); font-size: 11px; color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;float: none; color: rgb(0, 0, 0); display: inline !important;&quot;&gt;\(^{1}v_{g}(^{1}r) = \begin{bmatrix}v_{g0}(^{1}r_{0}) \\ v_{g1}(^{1}r_{1}, ^1r_2)\end{bmatrix} = \begin{bmatrix} \frac{Temp_e}{1.02} -1 \\ \frac{16168 \cdot T}{T_{uA}} -1 \end{bmatrix} \leq 0\)&lt;/span&gt;&lt;br style=&quot;border-color: rgb(218, 218, 218); color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;float: none; color: rgb(0, 0, 0); display: inline !important;&quot;&gt;\(^{1}v_{h}(^{2}r) = \emptyset = 0\)&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 180%;&quot;&gt;\(^{1}r:= \begin{bmatrix} Temp_e (^{1}x,\:^{2}_{1}h&lt;br style=&quot;border-color: rgb(218, 218, 218);&quot;&gt;)\\ T_{dim} \\ T_{uA}(^{1}x) \\ SFC(^{1}x) \\ ESF(^{1}x, \: ^{2}_{1}h) \\ W_e(^{1}x, \: ^{2}_{1}h) \end{bmatrix}\)&lt;/p&gt;&lt;p style=&quot;line-height: 180%;&quot;&gt;\(^{1}x := \begin{bmatrix} T\end{bmatrix}\)&lt;br style=&quot;border-color: rgb(218, 218, 218); color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="400" y="20" as="geometry" />
        </mxCell>
        <mxCell id="184zaT7-AdCGXbFeTAcl-5" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=light-dark(#e2e2e2, #272727);" value="&lt;font face=&quot;Times New Roman&quot;&gt;Subsystem 2 (Aerodynamics&lt;/font&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;" vertex="1">
          <mxGeometry height="320" width="400" x="-759.75" y="665" as="geometry" />
        </mxCell>
        <mxCell id="184zaT7-AdCGXbFeTAcl-6" parent="184zaT7-AdCGXbFeTAcl-5" style="text;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=middle;rounded=0;fontFamily=Times New Roman;spacingLeft=20;whiteSpace=wrap;html=1;convertToSvg=0;horizontal=1;" value="\(^{2}v_{f}(^{2}r) = 0\)&lt;br&gt;\(^{2}v_{g}(^{2}r) = \begin{bmatrix}^2v_{g_0}(^{2}r_{0}) \\ ^2v_{g_1}(^{2}r_{1}, \: ^2r_2)\\ ^2v_{g_2}(^2r_1, \: ^2r_2 )\end{bmatrix}= \begin{bmatrix} \frac{P_g}{1.1} -1 \\ 2\cdot CLo_2 - CLo_1 \\ -2\cdot CLo_2 - CLo_1 \end{bmatrix} \leq 0\)&lt;br&gt;\(^{2}v_{h}(^{2}r) = \emptyset = 0\)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;\(^{2}r:= \begin{bmatrix} P_g(^2_3z)&amp;nbsp;\\ CLo_1(^2x, \: ^2_3z, \: ^0_2h, \: ^3_2h) \\ CLo_2(^2x, \: ^2_3z, \: ^0_2h, \: ^3_2h) \\ L (^2x, \: ^2_3z, \: ^0_2h, \: ^3_2h) \\ D(^{2}x,\:^{2}_{3}z,\: ^0_2h, \:^{1}_{2}h, \: ^3_2h) \\ L/D&amp;nbsp; \end{bmatrix}\)&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;\(^{2}x := \begin{bmatrix}\lambda_{ht} \\ L_w \\ L_{ht}\end{bmatrix}\)&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
